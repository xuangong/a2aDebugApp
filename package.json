{
  "name": "a2a-debug-app",
  "version": "0.1.0",
  "description": "A debug application for testing A2A (Agent-to-Agent) protocol interfaces",
  "main": "dist/main.cjs",
  "author": {
    "name": "Zhang Xian"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:vite": "vite dev",
    "dev:electron": "bun run build:main && bun run build:preload && node -e \"setTimeout(()=>{},2000)\" && concurrently -k -n main,preload,app -c yellow,magenta,cyan \"bun run watch:main\" \"bun run watch:preload\" \"bunx electronmon .\"",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs --external:electron --external:fsevents",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron --external:fsevents",
    "watch:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs --external:electron --external:fsevents --watch=forever",
    "watch:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron --external:fsevents --watch=forever",
    "build:renderer": "vite build",
    "build": "bun run build:main && bun run build:preload && bun run build:renderer",
    "start": "bun run build && bunx electron .",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win"
  },
  "dependencies": {
    "jotai": "^2.10.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "canvas": "^3.2.2",
    "concurrently": "^9.2.1",
    "electron": "^39.5.1",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4",
    "esbuild": "^0.24.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  },
  "electronmon": {
    "patterns": [
      "dist/main.cjs",
      "dist/preload.cjs"
    ],
    "logLevel": "verbose"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
